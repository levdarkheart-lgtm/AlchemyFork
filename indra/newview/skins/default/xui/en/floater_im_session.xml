<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater
 background_visible="true"
 height="355"
 help_topic="floater_im_box"
 layout="topleft"
 name="panel_im"
 can_dock="false"
 can_minimize="true"
 can_close="true"
 save_rect="true"
 visible="false"
 width="400"
 can_resize="true"
 can_tear_off="false"
 min_height="190"
 min_width="400"
 positioning="relative">
    <floater.string name="call_btn_start">Conv_toolbar_open_call</floater.string>
    <floater.string name="call_btn_stop">Conv_toolbar_hang_up</floater.string>
    <floater.string name="native_im_original">Original (translation off)</floater.string>
    <floater.string name="native_im_system">System language</floater.string>
    <floater.string name="native_im_detect">Detect language</floater.string>
